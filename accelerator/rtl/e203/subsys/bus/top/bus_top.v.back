//`include "DW_axi_x2x_all_includes.vh"

module bus_top (
// System signals
input  wire        aclk,
input  wire        aresetn,

// Master1 (32-bit) interface
input  wire        awvalid_m1,
input  wire [31:0] awaddr_m1,
input  wire [3:0]  awid_m1,
input  wire [7:0]  awlen_m1,
input  wire [2:0]  awsize_m1,
input  wire [1:0]  awburst_m1,
input  wire        awlock_m1,
input  wire [3:0]  awcache_m1,
input  wire [2:0]  awprot_m1,
output wire        awready_m1,

