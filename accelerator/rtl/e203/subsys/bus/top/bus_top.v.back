output wire [3:0]  rid_m1,
output wire [31:0] rdata_m1,
output wire [1:0]  rresp_m1,
output wire        rlast_m1,
input  wire        rready_m1,

// Master2 (64-bit) interface
input  wire        awvalid_m2,
